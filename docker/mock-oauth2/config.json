{
  "interactiveLogin": false,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "scope",
          "match": "user-a",
          "claims": { "sub": "user-a", "token_use": "access", "client_id": "local-dev-client" }
        },
        {
          "requestParam": "scope",
          "match": "user-b",
          "claims": { "sub": "user-b", "token_use": "access", "client_id": "local-dev-client" }
        },
        {
          "requestParam": "scope",
          "match": "*",
          "claims": { "sub": "dev-user", "token_use": "access", "client_id": "local-dev-client" }
        }
      ]
    }
  ]
}
